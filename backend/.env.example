# RootMesh Backend — Environment Configuration Template
# Copy this file to .env and adjust variables for your local development or production environment.

# ──────────────────────────────────────────────
# Runtime Environment & Security Mode
# ──────────────────────────────────────────────
# Set to 'production' or 'development'. Production mode validates fail-closed security.
ENVIRONMENT=development
# Authentication mode: 'dev' (allows local HS256 tokens) or 'production' / 'enforce' (strict RS256/Clerk)
AUTH_MODE=dev
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# FalkorDB Graph Database Configuration
# ──────────────────────────────────────────────
# FalkorDB host and port (default 6379 for persistent operations, tests use isolated 6380)
FALKOR_HOST=localhost
FALKOR_PORT=6379
# Strong database password (leave blank for unauthenticated local development)
FALKOR_PASSWORD=
# Default tenant graph context
TENANT_ID=sec_ops_tenant_alpha

# ──────────────────────────────────────────────
# Network, CORS & API Gateways
# ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (in production, never use '*')
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WebSocket initial handshake authentication timeout (seconds)
WS_AUTH_TIMEOUT_SECONDS=5.0

# ──────────────────────────────────────────────
# Development JWT Configuration (HS256)
# ──────────────────────────────────────────────
# Used only in development mode. In production, JWT_SECRET must be at least 32 high-entropy characters.
JWT_SECRET=your_high_entropy_secret_here
JWT_ALGORITHM=HS256
JWT_ISSUER=rootmesh-auth
JWT_AUDIENCE=rootmesh-api
JWT_EXPIRATION_MINUTES=60

# ──────────────────────────────────────────────
# Clerk B2B Authentication (RS256 Production Mode)
# ──────────────────────────────────────────────
# Clerk Secret Key from dashboard (sk_test_... or sk_live_...)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_ISSUER=
# Clerk JWKS URL for live cryptographic key rotation
CLERK_JWKS_URL=
# Optional direct RSA PEM Public Key for air-gapped or test environments
# CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Authorized frontend origins ('azp' claim validation)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
# Strict JSON mapping from verified Clerk Organization IDs to RootMesh tenant graphs
CLERK_ORG_TO_TENANT_MAP={"org_2secops_alpha":"sec_ops_tenant_alpha","org_2secops_beta":"sec_ops_tenant_beta","org_enterprise_soc":"enterprise_soc_corp"}
