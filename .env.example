# RootMesh — Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.

# ──────────────────────────────────────────────
# FalkorDB Database Configuration
# ──────────────────────────────────────────────
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_PASSWORD=
TENANT_ID=sec_ops_tenant_alpha

# ──────────────────────────────────────────────
# Backend Application Configuration
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ──────────────────────────────────────────────
# Frontend Application Configuration
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
