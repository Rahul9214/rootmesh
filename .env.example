# RootMesh — Unified Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.

# ──────────────────────────────────────────────
# Runtime Environment & Security Mode
# ──────────────────────────────────────────────
ENVIRONMENT=development
AUTH_MODE=dev
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# FalkorDB Database Configuration
# ──────────────────────────────────────────────
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_PASSWORD=
TENANT_ID=sec_ops_tenant_alpha

# ──────────────────────────────────────────────
# Network, CORS & API Gateways
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_AUTH_TIMEOUT_SECONDS=5.0
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_FALKORDB_BROWSER_URL=http://localhost:3005
PORT=3000
HOSTNAME=0.0.0.0

# ──────────────────────────────────────────────
# Development JWT Configuration (HS256)
# ──────────────────────────────────────────────
JWT_SECRET=your_high_entropy_secret_here
JWT_ALGORITHM=HS256
JWT_ISSUER=rootmesh-auth
JWT_AUDIENCE=rootmesh-api
JWT_EXPIRATION_MINUTES=60

# ──────────────────────────────────────────────
# Clerk B2B Authentication Configuration
# ──────────────────────────────────────────────
# Frontend official Clerk environment variables (Client bundle)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/

# Backend & Middleware Clerk environment variables (RS256 token verification)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_ISSUER=https://sensible-lark-5708.clerk.accounts.dev
CLERK_JWKS_URL=https://sensible-lark-5708.clerk.accounts.dev/.well-known/jwks.json
# Optional direct RSA PEM public key (used for isolated or test environments)
# CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
CLERK_ORG_TO_TENANT_MAP={"org_2secops_alpha":"sec_ops_tenant_alpha","org_2secops_beta":"sec_ops_tenant_beta","org_enterprise_soc":"enterprise_soc_corp"}
