# RootMesh Frontend — Environment Configuration Template
# Copy this file to .env.local and adjust variables for your local development or production environment.

# ──────────────────────────────────────────────
# Backend Connectivity
# ──────────────────────────────────────────────
# Base URL for FastAPI REST endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
# Base URL for FalkorDB threat stream WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Optional FalkorDB Browser Visualizer URL (runs on container port 3000 mapped to 3005)
NEXT_PUBLIC_FALKORDB_BROWSER_URL=http://localhost:3005

# ──────────────────────────────────────────────
# Server & Standalone Runner Configuration
# ──────────────────────────────────────────────
PORT=3000
HOSTNAME=0.0.0.0

# ──────────────────────────────────────────────
# Clerk B2B Identity & Authentication
# ──────────────────────────────────────────────
# Public key exposed to client browser bundle
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# Secret key used by Clerk edge middleware (never exposed to browser)
CLERK_SECRET_KEY=your_clerk_secret_key
# Routing paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
