# RootMesh — Git Attributes Configuration
# Ensure consistent cross-platform line endings (LF) across Windows, Linux, and macOS

* text=auto eol=lf

# Python & Backend
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# TypeScript / JavaScript / Web
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Configuration & Documentation
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
Dockerfile text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
